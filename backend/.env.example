PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration
# Set DB_DIALECT=mysql to connect to a live MySQL Server
# Set DB_DIALECT=sqlite to run with embedded SQLite database
DB_DIALECT=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=granite_tile_mms

# Twilio SMS API Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
# Optional: TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid
