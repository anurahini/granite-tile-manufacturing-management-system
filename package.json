{
  "name": "granite-tile-manufacturing-management-system",
  "version": "1.0.0",
  "description": "Full-Stack Granite & Tile Manufacturing Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm install --prefix backend",
    "start": "node backend/server.js",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "seed:backend": "cd backend && npm run seed",
    "start:frontend": "cd granite-tile-mms && npm run dev",
    "build:frontend": "cd granite-tile-mms && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  }
}
